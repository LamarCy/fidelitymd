---
import { STORY, PHILOSOPHY, MISSION, VISION } from '../consts';
---
<section class="sec story" id="story">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Our Story</span>
      <h2>{STORY.heading}</h2>
    </div>

    <div class="narrative">
      {STORY.paragraphs.map((p) => <p>{p}</p>)}
      <p class="motto">{STORY.motto}</p>
    </div>

    <div class="pillars">
      {PHILOSOPHY.map((p) => (
        <div class="pillar">
          <span class="dot"></span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>

    <div class="mv">
      <div class="mv-card navy">
        <span class="mv-label">Our Mission</span>
        <p>{MISSION}</p>
      </div>
      <div class="mv-card blue">
        <span class="mv-label">Our Vision</span>
        <p>{VISION}</p>
      </div>
    </div>

    <p class="closing">{STORY.closing}</p>
  </div>
</section>

<style>
  .narrative { max-width: 760px; margin: 0 auto; text-align: center; }
  .narrative p { color: var(--muted); font-size: 17px; margin-bottom: 16px; }
  .motto {
    font-family: Poppins; font-weight: 600; font-size: clamp(19px, 2.2vw, 24px);
    color: var(--navy); margin-top: 8px !important;
    background: linear-gradient(120deg, var(--blue-2), var(--blue));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }

  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin: 56px 0; }
  .pillar {
    position: relative; padding: 32px 28px; border-radius: var(--r);
    background: rgba(255,255,255,0.34);
    -webkit-backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    border: 1px solid rgba(255,255,255,0.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.45), 0 14px 40px -26px rgba(8,27,52,0.22);
  }
  .pillar .dot { display: block; width: 34px; height: 6px; border-radius: 99px; margin-bottom: 18px; background: linear-gradient(90deg, var(--blue), var(--sky)); }
  .pillar h3 { font-size: 19px; color: var(--navy); margin-bottom: 8px; }
  .pillar p { color: var(--muted); font-size: 15px; }

  .mv { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .mv-card { position: relative; overflow: hidden; padding: 38px 36px; border-radius: var(--r); color: #fff; box-shadow: var(--shadow); }
  .mv-card.navy { background: radial-gradient(500px 240px at 90% 0%, rgba(63,134,238,0.35), transparent 60%), linear-gradient(160deg, var(--navy-deep), var(--navy-2)); }
  .mv-card.blue { background: radial-gradient(500px 240px at 90% 0%, rgba(255,224,186,0.28), transparent 60%), linear-gradient(160deg, var(--blue-2), var(--blue)); }
  .mv-label { display: inline-block; font-family: Poppins; font-weight: 600; font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--powder); margin-bottom: 12px; }
  .mv-card p { font-size: 17px; line-height: 1.55; color: rgba(255,255,255,0.94); }

  .closing {
    text-align: center; margin-top: 56px;
    font-family: Poppins; font-weight: 700; font-size: clamp(22px, 3vw, 34px); line-height: 1.15;
    color: var(--navy);
  }

  @media (max-width: 900px) {
    .pillars { grid-template-columns: 1fr; }
    .mv { grid-template-columns: 1fr; }
  }
</style>
