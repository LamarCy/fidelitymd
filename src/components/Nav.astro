---
import Logo from './Logo.astro';
import { NAV } from '../consts';
---
<nav id="siteNav">
  <div class="nav-inner">
    <Logo />
    <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">☰</button>
    <div class="nav-links" id="navLinks">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="#contact" class="btn btn-solid nav-cta">Contact Us</a>
    </div>
  </div>
</nav>

<style>
  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; }
  .nav-inner {
    margin: 14px auto; max-width: var(--maxw);
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
    padding: 10px 14px 10px 18px; border-radius: 999px; position: relative;
    background: rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 10px 40px -20px rgba(8, 27, 52, 0.4);
    transition: max-width 0.5s cubic-bezier(0.4, 0, 0.2, 1), padding 0.5s ease;
  }
  .nav-inner :global(.logo-mark) { width: 34px; }
  .nav-inner :global(.logo-img) { height: 40px; }
  .nav-inner :global(.logo-title) { font-size: 19px; }
  .nav-inner :global(.logo-sub) { font-size: 7.5px; letter-spacing: 0.3em; }

  .nav-links { display: flex; align-items: center; gap: 26px; font-size: 14.5px; font-weight: 500; color: var(--navy-2); }
  .nav-links > a:not(.btn) { opacity: 0.82; transition: 0.2s; }
  .nav-links > a:not(.btn):hover { opacity: 1; color: var(--blue-2); }
  .nav-cta { padding: 11px 22px; font-size: 14px; color: #fff; }

  .menu-btn {
    display: none; background: rgba(63, 134, 238, 0.1); border: 0; width: 40px; height: 40px;
    border-radius: 12px; font-size: 20px; color: var(--navy); cursor: pointer; line-height: 1;
    transition: background 0.2s ease;
  }
  .menu-btn:hover { background: rgba(63, 134, 238, 0.18); }

  /* ---- COLLAPSED (scrolled) / MOBILE: shrink to the logo pill ---- */
  nav.collapsed .nav-inner { max-width: 220px; padding-right: 10px; }
  nav.collapsed .menu-btn { display: block; }

  /* links become a floating dropdown panel, hidden until opened */
  nav.collapsed .nav-links {
    position: absolute; top: calc(100% + 10px); right: 6px;
    flex-direction: column; align-items: stretch; gap: 4px;
    min-width: 240px; padding: 12px; border-radius: 18px;
    background: rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 24px 50px -20px rgba(8, 27, 52, 0.4);
    opacity: 0; transform: translateY(-8px); pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  nav.collapsed.open .nav-links { opacity: 1; transform: none; pointer-events: auto; }
  nav.collapsed .nav-links > a:not(.btn) { padding: 10px 14px; border-radius: 12px; opacity: 1; }
  nav.collapsed .nav-links > a:not(.btn):hover { background: rgba(63, 134, 238, 0.1); }
  nav.collapsed .nav-cta { margin-top: 6px; justify-content: center; text-align: center; }
</style>

<script>
  const nav = document.getElementById('siteNav');
  if (nav) {
    const btn = nav.querySelector<HTMLButtonElement>('.menu-btn');
    const links = nav.querySelectorAll('.nav-links a');

    const setIcon = () => {
      if (!btn) return;
      const open = nav.classList.contains('open');
      btn.textContent = open ? '✕' : '☰';
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    const sync = () => {
      const collapsed = window.scrollY > 80 || window.innerWidth <= 900;
      nav.classList.toggle('collapsed', collapsed);
      if (!collapsed) nav.classList.remove('open');
      setIcon();
    };

    btn?.addEventListener('click', () => { nav.classList.toggle('open'); setIcon(); });
    links.forEach((a) => a.addEventListener('click', () => { nav.classList.remove('open'); setIcon(); }));
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
