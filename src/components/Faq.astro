---
import { FAQ_GROUPS, FAQ_CLOSING } from '../consts';
---
<section class="sec" id="faq">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Good to Know</span>
      <h2>Frequently asked questions</h2>
    </div>

    {FAQ_GROUPS.map((group, gi) => (
      <div class="faq-group">
        <h3 class="faq-cat">{group.category}</h3>
        <div class="faq-list">
          {group.items.map((f, i) => (
            <details class="faq" open={gi === 0 && i === 0}>
              <summary>{f.q}<span class="pm">+</span></summary>
              <div class="ans" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    ))}

    <div class="faq-closing">
      <h3>{FAQ_CLOSING.title}</h3>
      <p set:html={FAQ_CLOSING.body} />
      <a href="#contact" class="btn btn-solid">📅 &nbsp;{FAQ_CLOSING.cta}</a>
    </div>
  </div>
</section>

<style>
  .faq-group { max-width: 820px; margin: 0 auto 44px; }
  .faq-cat {
    font-size: 20px; color: var(--navy); margin: 0 0 18px; display: flex; align-items: center; gap: 12px;
  }
  .faq-cat::before {
    content: ""; width: 26px; height: 3px; border-radius: 3px;
    background: linear-gradient(90deg, var(--blue), var(--sky));
  }
  .faq-list { display: grid; gap: 14px; }
  .faq {
    background: rgba(255,255,255,0.34);
    -webkit-backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 18px; overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.45), 0 14px 40px -26px rgba(8,27,52,0.22);
  }
  summary { list-style: none; cursor: pointer; padding: 22px 26px; font-family: Poppins; font-weight: 600; font-size: 16.5px; color: var(--navy); display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  .pm { width: 26px; height: 26px; flex: none; border-radius: 8px; background: rgba(63,134,238,0.14); color: var(--blue-2); display: grid; place-items: center; transition: transform 0.25s ease; font-size: 18px; }
  .faq[open] .pm { transform: rotate(45deg); }
  .ans { padding: 0 26px 24px; color: var(--muted); font-size: 15.5px; }
  .ans :global(strong) { color: var(--navy); font-weight: 700; }

  .faq-closing {
    max-width: 820px; margin: 8px auto 0; text-align: center;
    padding: 44px 40px; border-radius: 24px;
    background: rgba(255,255,255,0.34);
    -webkit-backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    border: 1px solid rgba(255,255,255,0.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.45), 0 14px 40px -26px rgba(8,27,52,0.22);
  }
  .faq-closing h3 { font-size: 24px; color: var(--navy); margin-bottom: 12px; }
  .faq-closing p { color: var(--muted); font-size: 16px; max-width: 560px; margin: 0 auto 24px; }
  @media (max-width: 900px) { .faq-closing { padding: 36px 24px; } }
</style>
