---
import { FOUNDERS } from '../consts';
---
<section class="sec" id="founders">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Who We Are</span>
      <h2>Meet the Founders</h2>
      <p>Built by clinicians who believe student health belongs in the community.</p>
    </div>
    <div class="fd-grid">
      {FOUNDERS.map((f) => (
        <article class="fd">
          <div class="fd-img"><div class="ph">＋</div></div>
          <div class="fd-body">
            <h3>{f.name}</h3>
            <div class="role">{f.role}</div>
            <p>{f.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .fd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; max-width: 860px; margin: 0 auto; }
  .fd {
    background: rgba(255,255,255,0.34);
    -webkit-backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    border-radius: var(--r); border: 1px solid rgba(255,255,255,0.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.45), 0 16px 44px -26px rgba(8,27,52,0.24);
    overflow: hidden; transition: transform 0.3s ease;
  }
  .fd:hover { transform: translateY(-5px); }
  .fd:nth-child(1) .fd-img { background: linear-gradient(160deg, var(--navy-deep), var(--navy-2)); }
  .fd:nth-child(2) .fd-img { background: linear-gradient(160deg, var(--blue-2), var(--blue)); }
  .fd-img { height: 320px; display: grid; place-items: center; position: relative; }
  .fd-img::after { content: "Founder photo"; font-size: 13px; color: rgba(255,255,255,0.6); }
  .fd-img .ph { width: 78px; height: 78px; border-radius: 50%; background: rgba(255,255,255,0.14); border: 1px dashed rgba(255,255,255,0.5); display: grid; place-items: center; position: absolute; top: calc(50% - 55px); color: #fff; }
  .fd-body { padding: 24px 26px; }
  .fd-body h3 { font-size: 20px; color: var(--navy); }
  .role { color: var(--blue-2); font-weight: 600; font-size: 14px; margin-bottom: 8px; }
  .fd-body p { color: var(--muted); font-size: 14.5px; }
  @media (max-width: 900px) { .fd-grid { grid-template-columns: 1fr; } }
</style>
