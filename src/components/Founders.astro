---
import { TEAM } from '../consts';
const base = import.meta.env.BASE_URL;
---
<section class="sec team" id="team">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Who We Are</span>
      <h2>The People Behind the Mission</h2>
      <p>Fidelity was built by people who believe supporting the whole student should be simple.</p>
    </div>

    <div class="people">
      {TEAM.map((person) => (
        <article class="person">
          <div class="portrait">
            {person.img
              ? <img src={base + person.img} alt={`${person.name}, ${person.role}, Fidelity Healthcare Group`} />
              : <div class="ph">＋</div>}
          </div>
          <div class="pbio">
            {person.memorial && <span class="memorial">In loving memory</span>}
            <h3>{person.name}</h3>
            <div class="role">{person.role}</div>
            {person.bio.map((para) => <p>{para}</p>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .people { display: grid; gap: 34px; max-width: 1040px; margin: 0 auto; }
  .person {
    display: grid; grid-template-columns: 340px 1fr; gap: 40px; align-items: center;
    padding: 30px; border-radius: 26px;
    background: rgba(255,255,255,0.34);
    -webkit-backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    border: 1px solid rgba(255,255,255,0.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.45), 0 16px 44px -26px rgba(8,27,52,0.24);
  }
  .person:nth-child(even) { grid-template-columns: 1fr 340px; }
  .person:nth-child(even) .portrait { order: 2; }

  .portrait { border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 5; box-shadow: 0 20px 40px -22px rgba(8,27,52,0.4); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; display: block; }
  .portrait .ph { width: 100%; height: 100%; display: grid; place-items: center; background: linear-gradient(160deg, var(--navy-deep), var(--blue)); color: #fff; }

  .memorial {
    display: inline-block; font-family: Poppins; font-weight: 600; font-size: 11.5px;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--blue-2);
    padding: 5px 12px; border-radius: 999px; background: rgba(63,134,238,0.12);
    border: 1px solid rgba(63,134,238,0.25); margin-bottom: 12px;
  }
  .pbio h3 { font-size: clamp(22px, 2.4vw, 27px); color: var(--navy); }
  .role { color: var(--blue-2); font-weight: 600; font-size: 14.5px; margin: 4px 0 16px; letter-spacing: 0.02em; }
  .pbio p { color: var(--muted); font-size: 15px; margin-bottom: 12px; }
  .pbio p:last-child { margin-bottom: 0; }

  @media (max-width: 820px) {
    .person, .person:nth-child(even) { grid-template-columns: 1fr; gap: 24px; }
    .person:nth-child(even) .portrait { order: 0; }
    .portrait { max-width: 300px; margin: 0 auto; }
  }
</style>
