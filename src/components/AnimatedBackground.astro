---
/**
 * Global moving, amorphic background — morphing blurred blobs with a
 * travelling bright core (light moving through the bubbles).
 * Sits fixed behind all page content (wattnext-style ambient motion).
 */
---
<div class="bg-canvas" aria-hidden="true">
  <span class="blob blob-1"></span>
  <span class="blob blob-2"></span>
  <span class="blob blob-3"></span>
  <span class="blob blob-4"></span>
</div>
