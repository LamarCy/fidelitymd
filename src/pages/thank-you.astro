---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../consts';
---
<BaseLayout title={`Thank you — ${SITE.name}`}>
  <main class="ty">
    <div class="ty-card">
      <Logo />
      <div class="check">✓</div>
      <h1>Thank you — message received.</h1>
      <p>
        We appreciate you reaching out. A member of the Fidelity Healthcare Group
        team will follow up soon. Need something sooner? Call
        <a href={SITE.phoneHref}>{SITE.phone}</a>.
      </p>
      <a href="/" class="btn btn-solid">← Back to home</a>
    </div>
  </main>
</BaseLayout>

<style>
  .ty { min-height: 100vh; display: grid; place-items: center; padding: 40px 24px; }
  .ty-card {
    position: relative; z-index: 1; max-width: 560px; text-align: center;
    padding: 48px 40px; border-radius: 28px; color: #fff;
    background:
      radial-gradient(600px 300px at 85% -20%, rgba(143,194,245,0.5), transparent 60%),
      linear-gradient(135deg, var(--navy-deep), var(--navy-2) 55%, var(--blue));
    box-shadow: var(--shadow);
  }
  .ty-card :global(.logo) { justify-content: center; margin-bottom: 26px; }
  .check {
    width: 66px; height: 66px; border-radius: 50%; margin: 0 auto 20px;
    display: grid; place-items: center; font-size: 30px; color: #04231f;
    background: linear-gradient(135deg, var(--sky), var(--powder));
  }
  h1 { font-size: clamp(26px, 4vw, 34px); margin-bottom: 12px; }
  .ty-card p { color: rgba(255,255,255,0.86); font-size: 16.5px; margin-bottom: 26px; }
  .ty-card a { color: var(--sky); font-weight: 600; }
  .btn-solid { color: #fff; text-decoration: none; }
</style>
