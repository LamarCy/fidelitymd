---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../consts';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`Page not found — ${SITE.name}`}>
  <main class="nf">
    <div class="nf-card">
      <Logo />
      <p class="code">404</p>
      <h1>We couldn't find that page</h1>
      <p class="msg">
        The page you're looking for may have moved or no longer exists — but
        we're still here to support your students' bodies and minds.
      </p>
      <div class="nf-actions">
        <a href={base} class="btn btn-solid">Back to home</a>
        <a href={SITE.phoneHref} class="phone-pill">
          <svg viewBox="0 0 24 24" fill="none"><path d="M4 4h4l2 5-3 2a12 12 0 006 6l2-3 5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 011-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          {SITE.phone}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .nf { min-height: 100vh; display: grid; place-items: center; padding: 120px 24px; position: relative; z-index: 1; }
  .nf-card {
    max-width: 560px; width: 100%; text-align: center; padding: 48px 40px; border-radius: 28px;
    background: rgba(255,255,255,0.34);
    -webkit-backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    backdrop-filter: blur(var(--fog-blur)) saturate(135%);
    border: 1px solid rgba(255,255,255,0.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.45), 0 22px 55px -28px rgba(8,27,52,0.35);
  }
  .nf-card :global(.logo) { justify-content: center; margin-bottom: 22px; }
  .code {
    font-family: Poppins, sans-serif; font-weight: 700; font-size: clamp(56px, 12vw, 96px); line-height: 1;
    background: linear-gradient(120deg, var(--blue-2), var(--blue)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    margin-bottom: 6px;
  }
  h1 { font-size: clamp(22px, 3vw, 28px); color: var(--navy); margin-bottom: 12px; }
  .msg { color: var(--muted); font-size: 16px; margin: 0 auto 28px; max-width: 420px; }
  .nf-actions { display: flex; gap: 16px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .nf-actions .phone-pill { color: var(--navy); }
  .nf-actions .phone-pill svg { color: var(--blue-2); }
</style>
